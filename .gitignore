# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Pipeline output. `main()`'s default argv writes logminer.jsonl into the
# cwd, so running the CLI from a checkout drops mined transcripts in the
# repo root. `*_raw.jsonl` is pre-redaction and may contain live API keys —
# a stray `git add -A` would publish them.
*.jsonl

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
